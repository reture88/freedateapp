{
  "$version": 4,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git branch --list*)",
      "Bash(git branch -a)",
      "Bash(git remote -v)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git checkout -b *)",
      "Bash(git checkout main)",
      "Bash(git switch *)",
      "Bash(gh auth status)",
      "Bash(gh issue list*)",
      "Bash(gh issue view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose exec php composer test*)",
      "Bash(docker compose exec php composer phpstan*)",
      "Bash(docker compose exec php composer cs-check*)",
      "Bash(docker compose exec php composer cs-fix*)",
      "Bash(docker compose exec php php artisan route:list*)",
      "Bash(docker compose exec php php artisan test*)",
      "Agent",
      "mcp__figma",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh release create *)",
      "Bash(docker compose down *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose exec php php artisan migrate*)",
      "Bash(docker compose exec php php artisan db:*)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./app/.env)"
    ]
  },
  "mcpServers": {
    "figma": {
      "httpUrl": "https://mcp.figma.com/mcp",
      "trust": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "trust": true
    }
  }
}
